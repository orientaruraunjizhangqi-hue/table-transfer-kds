rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 卓移動 KDS: URL を知っていれば誰でも読み書き可能
    match /kds_orders/{orderId} {
      allow read, write: if true;
    }
    match /kds_settings/{docId} {
      allow read, write: if true;
    }
    // それ以外は拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
